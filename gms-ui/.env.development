# ============================================================
#  开发环境配置（yarn dev，前端跑在 8787，后端跑在 8686）
# ============================================================
# 前端开发服务器调用后端接口的地址。
# 留空则走同源相对路径（也就是和前端同一个端口），只有打包进 jar 时才这样做。
VITE_API_BASE_URL=http://localhost:8686

# ------------------------------------------------------------
# 想改上面的地址、又不想动这个文件（不污染 git），
# 就在同目录新建一个 .env.development.local（已被 .gitignore 的 *.local 忽略），
# 在里面写同名的变量覆盖，例如：
#     VITE_API_BASE_URL=http://192.168.1.5:8686
# 优先级：.env.development.local > .env.development
# ------------------------------------------------------------
